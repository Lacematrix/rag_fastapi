# FastAPI
API_PREFIX=/api/v1

# Milvus
MILVUS_URI=./milvus.db
MILVUS_TOKEN=
DEFAULT_COLLECTION=rag_default_store
GLOBAL_COLLECTIONS=["kb_oa","kb_insurance","kb_redis"]
COLLECTION_CONFIG_PATH=app/data/collections.sample.json
DEFAULT_EMBEDDING_DIM=1024

# Local Qwen chat (OpenAI compatible endpoint)
CHAT_BASE_URL=http://127.0.0.1:11434/v1
CHAT_API_KEY=EMPTY
CHAT_MODEL=qwen3:8b

# Local embedding / rerank models
EMBEDDING_MODEL_NAME=/userhome/cs/u3651279/data/emb/Qwen3-Embedding-0.6B
RERANK_MODEL_NAME=/userhome/cs/u3651279/data/emb/Qwen3-Reranker-0.6B
RERANK_BASE_URL=http://127.0.0.1:11434/v1/
RERANK_API_KEY=ollama

# RAG behavior
TOP_K=8
QUERY_REWRITE_ENABLED=true
GUIDANCE_ENABLED=true
CHUNK_MODE=structure_aware
